# Salin nilai-nilai ini ke file .env saat aplikasi diakses lewat Cloudflare Tunnel.
APP_ENV=production
APP_DEBUG=false                       # WAJIB false saat publik (jangan bocorkan stack trace)
APP_URL=https://scp.domainanda.com    # atau https://xxxx.trycloudflare.com untuk tunnel cepat
APP_LOCALE=id

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true            # cookie sesi hanya lewat HTTPS
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
